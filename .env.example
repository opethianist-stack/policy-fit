# 실제 값은 여기에 쓰지 않는다. 이 파일은 변수 이름만 공유하는 템플릿이다.
# 로컬 실행: 이 파일을 .env.local 로 복사한 뒤 값을 채운다 (.env.local 은 git에 올라가지 않는다).
# 배포: Vercel → 프로젝트 → Settings → Environment Variables 에 등록한다.

# 공공데이터포털(data.go.kr) 인증키 — '디코딩' 키를 넣는다.
# 사용처: 과기부 주요정책, 나라장터 입찰공고, 공공기관 정보, 사업 정보
DATA_GO_KR_KEY=

# 알리오플러스(alioplus.go.kr) 인증키 — 위와 별개로 발급받는 키다.
# 발급: alioplus.go.kr 소셜 로그인 → Open API 메뉴 → API 발급
ALIO_API_KEY=
