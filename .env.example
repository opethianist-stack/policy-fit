# 실제 값은 여기에 쓰지 않는다. 이 파일은 변수 이름만 공유하는 템플릿이다.
# 로컬 실행: 이 파일을 .env.local 로 복사한 뒤 값을 채운다 (.env.local 은 git에 올라가지 않는다).
# 배포: Vercel → 프로젝트 → Settings → Environment Variables 에 등록한다.

# 공공데이터포털(data.go.kr) 인증키 — 일반 인증키 한 개로 아래 API를 모두 호출한다.
# 사용처: 나라장터 입찰공고·사전규격, 과기부 주요정책·사업공고·보도자료·보도설명, 공공기관 정보, 공공기관 사업정보
DATA_GO_KR_KEY=

# 알리오플러스(alioplus.go.kr) 인증키 — 포털 키와 별개이고, API 4종마다 따로 발급받는다.
# 발급: alioplus.go.kr 소셜 로그인 → Open API 메뉴 → API별로 각각 발급
ALIO_APBA_KEY=
ALIO_BIZ_KEY=
ALIO_FACILITY_KEY=
ALIO_EVENT_KEY=

# Claude API 키 — AI 보조 5곳(검색어 추천·역할 분류·관련도 정렬·문서 초안·장표 문구)에서 쓴다. 없으면 AI 버튼만 "키 미설정"으로 안내하고 나머지는 그대로 동작한다.
ANTHROPIC_API_KEY=
# Claude Code 클라우드 작업 환경은 ANTHROPIC_* 이름을 쓸 수 없다. 거기서는 이 이름으로 넣는다(둘 중 하나만 있으면 된다).
POLICYFIT_ANTHROPIC_KEY=
# 선택. 비우면 claude-haiku-4-5-20251001
ANTHROPIC_MODEL=
